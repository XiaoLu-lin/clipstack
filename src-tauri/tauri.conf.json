{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipStack",
  "version": "0.2.1",
  "identifier": "com.user.clipstack",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ClipStack",
        "label": "main",
        "width": 570,
        "height": 640,
        "minWidth": 480,
        "minHeight": 480,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "alwaysOnTop": true,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1MjQzQTdBRUMyNTE1OTYKUldTV0ZTWHNlam9rNVE3Y1czNndnczhaUUdZK1gyaHBJWS95R3VqVzJtOVArNHRjbjVGWGpHMHYK",
      "endpoints": [
        "https://github.com/XiaoLu-lin/clipstack/releases/latest/download/latest.json"
      ]
    }
  }
}
